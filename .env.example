# Optional Gemini (unused by payment flows)
GEMINI_API_KEY=

# Neon Postgres (durable gift ledger). Without this, API uses in-memory store
# (lost on Render restart). Use Neon pooled connection string.
DATABASE_URL=

# Optional AWC Vault CMS newcomer interest handoff (from guided giving)
# POST JSON lead when a visitor opts in to join Vault
AWC_VAULT_INTEREST_URL=
# Shown to donors after opt-in (member setup / church site)
AWC_VAULT_SETUP_URL=https://anointedworshipcenter.com

# Stripe — card / wallet (leave empty for client simulator)
# Settlement: configure Stripe bank payouts to the church DCU account
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Plaid — bank link / ACH (leave empty for client simulator)
# Offer alongside Stripe; donor chooses Card or Plaid Bank on Give form
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# AWC Digital Contribution Book bridge
# Leave AWC_DCB_API_URL empty to use the local mock at /api/dcb/mock/entries
# Base URL (recommended) or full ingest path:
#   https://your-dcb.onrender.com
#   https://your-dcb.onrender.com/api/public/giving/contributions
AWC_DCB_API_URL=
# Same value as DCB env AWC_DCB_SERVICE_SECRET (HMAC). AWC_DCB_API_KEY is an alias.
AWC_DCB_SERVICE_SECRET=
AWC_DCB_API_KEY=
AWC_DCB_BOOK_ID=AWC-DCB-2026-GCC

# Staff Portal — invite/access code required (never exposed to the browser)
# Share this only with authorized church stewards. Without it, Staff Portal stays locked.
STAFF_ACCESS_CODE=
# Alias accepted:
# STAFF_INVITE_CODE=

# API server (Render sets PORT automatically)
PORT=3001
