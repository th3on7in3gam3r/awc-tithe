# =============================================================================
# Server-only (never use VITE_ prefix)
# =============================================================================

# Neon Postgres (durable gift ledger). Without this, API uses in-memory store
# (lost on Render restart) unless DEV_MEMORY_STORE=true in local/test.
DATABASE_URL=

# Stripe Payment Element — card, Apple Pay, Google Pay, and US bank account.
# Fee rates live in shared/fees.ts. The server recomputes them.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Dashboard webhook URL: https://<your-host>/api/stripe/webhook
# Any API version works on the endpoint (e.g. the Dashboard default). The server
# re-fetches each object from Stripe at its pinned version, 2025-08-27.basil.
# Events: payment_intent.processing, payment_intent.succeeded, payment_intent.payment_failed,
# invoice.paid, invoice.payment_failed, customer.subscription.deleted, charge.refunded

# AWC Digital Contribution Book bridge
# Base URL of the DCB app (Tithe appends /api/public/giving/contributions).
AWC_DCB_API_URL=
# HMAC key — same value as DCB AWC_DCB_SERVICE_SECRET. Tithe signs as X-AWC-Key-Id: tithe.
AWC_DCB_KEY_TITHE=
# Shared HMAC key AWC Vault uses to check event RSVP payments (Vault: AWC_TITHE_VAULT_KEY)
AWC_VAULT_KEY=
# Set to true in production to refuse boot when DCB vars are missing.
DCB_REQUIRED=false

# Person-to-person giving — Zelle and Venmo are confirmed by Finance, never
# automatically. Each option appears on the giving page only when set.
ZELLE_RECIPIENT=
# Name donors will see on the Zelle confirmation (defaults to CHURCH_LEGAL_NAME)
ZELLE_RECIPIENT_NAME=
# Venmo business profile username, without @
VENMO_HANDLE=anointedworshipcenter
# Cash App person-to-person: the church's $cashtag or phone number. Confirmed
# by Finance like Zelle/Venmo (different from Cash App Pay below).
CASHAPP_RECIPIENT=
# Name Cash App shows for that account (e.g. Anointed Worship Center).
CASHAPP_RECIPIENT_NAME=
# Cash App Pay through Stripe (confirmed instantly by webhook). Turn on only
# after enabling Cash App Pay in Stripe Dashboard → Settings → Payment methods.
STRIPE_CASHAPP_PAY_ENABLED=false

# Text-to-give (Twilio toll-free number, text GIVE). Twilio console → the number →
# Messaging configuration → "A message comes in" → Webhook
#   https://<your-host>/api/sms/incoming  (HTTP POST)
# The auth token verifies each request's X-Twilio-Signature (required in production).
TWILIO_AUTH_TOKEN=
# Only if the webhook URL in Twilio differs from PUBLIC_APP_URL + /api/sms/incoming
# TWILIO_WEBHOOK_URL=
# Giving page texted back (defaults to PUBLIC_APP_URL); ?from=sms is added
# SMS_GIVING_URL=

# First admin, without database access: set this, restart, and copy the
# single-use invite link from the server log. Ignored once an admin exists.
# BOOTSTRAP_ADMIN_EMAIL=

# Church legal / support identity (public — shown in footer & receipts)
CHURCH_NAME=Anointed Worship Center
CHURCH_LEGAL_NAME=Anointed Worship Center Inc.
CHURCH_ADDRESS=4 School St
CHURCH_CITY_STATE_ZIP=Acton, MA 01720
CHURCH_EIN=
CHURCH_PHONE=
CHURCH_SUPPORT_EMAIL=stewardship@anointedworshipcenter.com
CHURCH_WEBSITE=https://anointedworshipcenter.com

TURNSTILE_SECRET_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001
PUBLIC_APP_URL=http://127.0.0.1:3000
MIN_GIFT_CENTS=500
RATE_LIMIT_OTP_EMAIL_PER_HOUR=5
RATE_LIMIT_OTP_IP_PER_HOUR=10
RATE_LIMIT_PAY_IP_PER_10MIN=10
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=
# EMAIL_FROM is a fallback sender address if RECEIPT_FROM_EMAIL is unset.
# EMAIL_FROM=stewardship@anointedworshipcenter.com
PORT=3001
# Local/test only. Forbidden when NODE_ENV=production.
# DEV_MEMORY_STORE=true

# =============================================================================
# Client (Vite build-time — never put secrets in VITE_*)
# =============================================================================
VITE_TURNSTILE_SITE_KEY=
