{
  "name": "awc-tithe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "start": "tsx server/start-prod.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:removed-routes && npm run test:stripe-webhook && npm run test:dcb-outbox && npm run test:admin-goals && npm run test:staff-auth && npm run test:staff-roles && npm run test:staff-mfa",
    "test:admin-goals": "tsx server/tests/adminGoalsAuth.test.ts",
    "test:dcb-outbox": "tsx server/tests/dcbOutbox.test.ts",
    "test:stripe-webhook": "tsx server/tests/stripeWebhook.test.ts",
    "test:removed-routes": "tsx server/tests/removedRoutes.test.ts",
    "test:staff-auth": "tsx server/tests/staffAuth.test.ts",
    "test:staff-roles": "tsx server/tests/staffRoles.test.ts",
    "test:staff-mfa": "tsx server/tests/staffMfa.test.ts",
    "recompute-donor-totals": "tsx server/scripts/recomputeDonorTotals.ts",
    "create-admin": "tsx server/scripts/createAdmin.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-auth": "^1.7.7",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "resend": "^6.32.1",
    "stripe": "^18.0.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
